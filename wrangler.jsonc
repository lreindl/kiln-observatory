{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiln-observatory",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  // Uptime checks reach the games as a player would, over the public internet,
  // including the game Workers on this account (otherwise error 1042).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STUDIO", "class_name": "Studio" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Studio"] }],
  "vars": {
    "FACTORY_REPO": "lreindl/game-kiln",
    "NAMED_GAMES": "",
    "HISTORY_SINCE": "2026-10-07T00:00:00Z"
  },
  "observability": { "enabled": true }
  // Secrets, set by the owner with `wrangler secret put`: WEBHOOK_SECRET, GITHUB_TOKEN.
}
